# Production deployments read DB_USERNAME and DB_PASSWORD from GitHub repository secrets.
# This file is an EXAMPLE for local Compose only. Never commit real credentials.
POSTGRES_USER=geocauce
# A deployment stores DB_PASSWORD separately in /opt/geocauce/db-password.
# For local Docker Compose, create the password file at that location.
JWT_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_HEX
SITE_ADDRESS=geocauce.example.org
ALLOW_SIGNUP=false
MAX_UPLOAD_BYTES=16777216
